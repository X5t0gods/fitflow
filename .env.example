# 本地运行无需创建 .env，默认使用 3210 端口和 data/。
PORT=3210
HOST=0.0.0.0
NODE_ENV=development
# 云端部署时设为至少 12 位随机密码，不要使用示例值。
APP_PASSWORD=
# 绑定你自己的域名，多个主机名以英文逗号分隔。
ALLOWED_HOSTS=fit.example.com
# 仅在 HTTPS 服务端部署时设为 true；局域网 HTTP 使用 false。
COOKIE_SECURE=false
# Docker Compose HTTPS 部署时填写你已解析到云服务器的域名。
DOMAIN=fit.example.com
